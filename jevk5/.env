# Defaults for compose.yaml and the Makefile. Plain KEY=value (read by both make and compose).
# GPUS: one host GPU index (as nvidia-smi numbers it). The runtime uses a single GPU (~10 GB at fp16).
GPUS=2
PORT=8090
# DTYPE: float16 (default) or float32. V100 has no bf16; both give the same top answer on
# all 231 public JevBench items, and float16 is ~3x faster.
DTYPE=float16
# REVISION: model commit to serve; make download fetches the same one.
REVISION=27d2d6b8d4714807f6293b0623bd7370b27e42f8
IMAGE=llm/jevk5:0.2.2

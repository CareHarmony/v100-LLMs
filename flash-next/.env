# Defaults for compose.yaml and the Makefile. Plain KEY=value (read by both make and compose).
# GPUS: host GPU indices to run on (as nvidia-smi numbers them). 0-3 share one NVLink quad.
# The fork supports Flash-Next at TP 1, 2 or 4 only, so list 1, 2 or 4 GPUs (or set TP).
GPUS=0,1,2,3
# TP: tensor-parallel size; leave empty to use every GPU in GPUS.
TP=
PORT=8000
MEM_UTIL=0.90
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=4
# EXTRA_ARGS: appended to vllm serve
EXTRA_ARGS=
IMAGE=llm/qwen3.8-flash-next-nvfp4:1cat-1.5.0
WHEEL_DIR=/data/wheels

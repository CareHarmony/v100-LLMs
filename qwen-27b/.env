# Defaults for compose.yaml and the Makefile. Plain KEY=value (read by both make and compose).
# GPUS: host GPU indices to run on (as nvidia-smi numbers them). 4-7 share one NVLink quad.
GPUS=4,5,6,7
# TP: tensor-parallel size; leave empty to use every GPU in GPUS.
TP=
PORT=8001
MEM_UTIL=0.90
MAX_MODEL_LEN=262144
# EXTRA_ARGS: appended to vllm serve, e.g. --max-num-seqs 8
EXTRA_ARGS=
IMAGE=llm/qwen3.8-27b-dflash2:1cat-1.5.0
WHEEL_DIR=/data/wheels
